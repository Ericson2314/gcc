#Software Foundation; either version 3, or (at your option) any later
#version.

#GCC is distributed in the hope that it will be useful, but WITHOUT
#ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
#FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License
#for more details.

#You should have received a copy of the GNU General Public License
#along with GCC; see the file COPYING3.  If not see
#<http://www.gnu.org/licenses/>.

# THIS IS NOW THE ONLY THING THAT RUNS fixincludes.
#
# It used to be the second of two: gcc/Makefile.in's `stmp-fixinc' rule fixed
# one machine's headers during gcc's own build and installed the result, and
# this script re-did it after install.  gcc/ has no target -- one binary serves
# every back end -- so it had no headers of its own to fix, and the directory
# it wrote them to, $(libdir)/gcc/$(version)/include-fixed, has no target
# component: N targets would have overwritten each other there in turn, with no
# diagnostic.  That rule is gone.  What is left is this, run once per target,
# which is what fixincludes always was underneath -- `fixincl' fnmatches
# TARGET_MACHINE against each hack's `mach' glob at RUN time, and 137 of its
# 252 hacks carry one.  The tool needed no change; only its caller did.
#
# Consequently THE TARGET IS AN ARGUMENT, not a configure substitution.  It has
# to be: this script is installed once, under a directory with no target in its
# path, and the top-level build (which does know the targets, being the
# dispatcher) will invoke it once per configured target from that one copy.
# `--headers' likewise: it was `SYSTEM_HEADER_DIR' baked into mkheaders.conf at
# gcc-build time, i.e. one target's system headers written down as everyone's.
#
# The target is deliberately NOT a configure substitution here.  Do not make it
# one.  (This comment cannot spell that macro literally: config.status generates
# this file, and would substitute it -- which is how the previous wording came
# out reading "# <the configured triple> is deliberately NOT read here", a
# comment that had been silently rewritten into nonsense by the very mechanism
# it was warning against.)

version=@gcc_version@

me=`basename "$0"`

usage () {
    cat <<EOF
Usage: $me [options] --target=TRIPLE --headers=DIR

Fix TRIPLE's system headers, in DIR, into --incdir.

Required:
  --target=TRIPLE   the machine whose headers these are.  Passed to fixincl as
                    TARGET_MACHINE; it selects which hacks apply.
  --headers=DIR     that machine's system header directory (was
                    SYSTEM_HEADER_DIR in mkheaders.conf).

One of:
  --gcc=CMD         a compiler invocation for TRIPLE, used to build macro_list
                    (the macros the preprocessor predefines, which fixinc.sh
                    consults so it does not rename one of them).
  --macro-list=FILE a macro_list built earlier.

Directories -- THE CALLER DEFINES THESE.  There are no defaults: a default
would re-encode gcc's install layout here, which is exactly what this script
must not hold an opinion about.
  --itoolsdatadir=DIR  REQUIRED.  Where fixinc_list, gsyslimits.h and the
                       per-multilib limits.h live, installed by gcc's
                       \`install-mkheaders'.
  --incdir=DIR         REQUIRED.  THE OUTPUT: where this target's fixed
                       headers go.  Give each target its own.
  --itoolsdir=DIR      where fixincl and fixinc.sh live.  Defaults to this
                       script's own directory, which is where they are
                       installed, so it is normally unnecessary.

Options:
  --isysroot=DIR    prepended to --headers when reading.
  --other-dirs="D..."  extra header directories to fix (was
                       OTHER_FIXINCLUDES_DIRS).
  -v                Print more output (may be repeated for even more output)
  --help            This help
  --version         Print version information
EOF
}

VERBOSE=0
target=
sysheaders=
gcc_cmd=
macro_list_in=
other_dirs=
isysroot=
itoolsdir=
itoolsdatadir=
incdir=

while [ $# -gt 0 ] ; do
    case $1 in
	-v)              VERBOSE=`expr $VERBOSE + 1` ;;
	--target=*)      target=`expr "x$1" : 'x--target=\(.*\)'` ;;
	--headers=*)     sysheaders=`expr "x$1" : 'x--headers=\(.*\)'` ;;
	--gcc=*)         gcc_cmd=`expr "x$1" : 'x--gcc=\(.*\)'` ;;
	--macro-list=*)  macro_list_in=`expr "x$1" : 'x--macro-list=\(.*\)'` ;;
	--other-dirs=*)  other_dirs=`expr "x$1" : 'x--other-dirs=\(.*\)'` ;;
	--isysroot=*)    isysroot=`expr "x$1" : 'x--isysroot=\(.*\)'` ;;
	--itoolsdir=*)   itoolsdir=`expr "x$1" : 'x--itoolsdir=\(.*\)'` ;;
	--itoolsdatadir=*)
	                 itoolsdatadir=`expr "x$1" : 'x--itoolsdatadir=\(.*\)'` ;;
	--incdir=*)      incdir=`expr "x$1" : 'x--incdir=\(.*\)'` ;;
	--help)          usage; exit 0 ;;
	--version)
	    echo "mkheaders (GCC) version $version"
	    echo "Copyright 2002, 2007, 2009 Free Software Foundation, Inc."
	    echo "This program is free software; you may redistribute it under the"
	    echo "terms of the GNU General Public License.  This program has"
	    echo "absolutely no warranty."
	    exit 0 ;;
	--*) echo "$me: unknown option $1" >&2; usage >&2; exit 1 ;;
	*)   break ;;
    esac
    shift
done
export VERBOSE

# EVERY MISSING ANSWER BELOW IS A HARD ERROR NAMING ITSELF.  None of them gets
# a default, and in particular `target' does not fall back to the machine this
# runs on: an empty TARGET_MACHINE puts fixincl in its self-test mode, where
# per-machine gating is switched off and EVERY machine's fixes are applied --
# which is how the VxWorks unistd.h wrapper once made libgcc unbuildable.  A
# wrong-but-plausible default here is a silently mis-fixed header tree.

if [ -z "$target" ] ; then
    echo "$me: no --target=TRIPLE." >&2
    echo "  fixincludes fixes ONE machine's headers and must be told which;" >&2
    echo "  its hacks are gated on that name at run time.  There is no" >&2
    echo "  default, deliberately -- see the comment at the top of this file." >&2
    exit 1
fi

if [ -z "$sysheaders" ] ; then
    echo "$me: no --headers=DIR for $target." >&2
    echo "  This is the directory holding $target's system headers.  It was" >&2
    echo "  SYSTEM_HEADER_DIR in mkheaders.conf, baked in when gcc was built," >&2
    echo "  i.e. one target's answer recorded as everyone's.  State it here." >&2
    exit 1
fi

# NO POSITIONAL ARGUMENTS.  This script used to take `[prefix [isysroot]]';
# isysroot is --isysroot= now and prefix is gone entirely, see below.
if [ $# -gt 0 ] ; then
    echo "$me: unexpected argument \`$1'." >&2
    echo "  This script takes options only.  The positional \`prefix' is gone:" >&2
    echo "  say where things are with --itoolsdatadir= and where output goes" >&2
    echo "  with --incdir=.  The second positional is now --isysroot=DIR." >&2
    exit 1
fi

# THE DIRECTORIES, WHICH THE CALLER DEFINES -- WITH NO DEFAULTS.
#
# There was a `prefix' here, and the prefix/exec_prefix/libdir/libexecdir
# configure substitutions with it, purely to compute defaults for the three
# directories below.  All of it is gone, and that removes a trap rather than
# merely documenting one: nothing in this file ever mentioned $prefix, yet it
# was load-bearing, because the exec_prefix substitution expands to the LITERAL
# TEXT `${prefix}' and the libdir one to `${exec_prefix}/lib'.  The reference
# existed only after config.status ran, so no grep of this file could see it.
# With those substitutions gone there is nothing left to be silently
# load-bearing.  (This comment spells none of them with at-signs for the same
# reason -- config.status would substitute them here too.)
#
# No defaults, for the same reason `target' and `sysheaders' have none: a
# default here re-encodes gcc's install layout, and a layout this script merely
# COPIES from another component is one it can silently disagree with.  It did
# once -- gcc's `install-mkheaders' wrote fixinc_list to a directory this script
# did not read -- and each half succeeded with exit 0.  Every missing answer is
# a hard error naming itself.

# `itoolsdir' IS NOT ASKED FOR: this script is installed INTO it, next to
# fixincl and fixinc.sh, so it can find itself.  That is correct wherever it is
# installed, including a store path, and it cannot disagree with reality the way
# a configure-time answer could.  --itoolsdir= overrides it for odd layouts.
if [ -z "$itoolsdir" ] ; then
    itoolsdir=`dirname "$0"`
    case ${itoolsdir} in
	/*) ;;
	*)  itoolsdir=`cd "${itoolsdir}" && pwd` ;;
    esac
fi

if [ -z "$itoolsdatadir" ] ; then
    echo "$me: no --itoolsdatadir=DIR." >&2
    echo "  That is where gcc's \`install-mkheaders' put fixinc_list," >&2
    echo "  gsyslimits.h and the per-multilib limits.h.  It is a different" >&2
    echo "  tree from --itoolsdir, so it cannot be derived from this script's" >&2
    echo "  own location, and it is not guessed: guessing it wrong means" >&2
    echo "  reading a multilib list that was written for another layout." >&2
    exit 1
fi

# THE PER-TARGET OUTPUT DIRECTORY, and the one thing this script exists to
# write.  Running mkheaders again for the same target REPLACES that target's
# fixed headers and touches no other target's -- so a caller must give each
# target its own, which is precisely why there is no default to get wrong.
if [ -z "$incdir" ] ; then
    echo "$me: no --incdir=DIR for $target." >&2
    echo "  This is where $target's fixed headers go.  There is no default:" >&2
    echo "  one compiler serves every back end, so a path computed here would" >&2
    echo "  have to carry the target itself, and two targets sharing it would" >&2
    echo "  overwrite each other in turn with no diagnostic." >&2
    exit 1
fi
mkinstalldirs="${itoolsdir}/mkinstalldirs"

if [ ! -f ${itoolsdatadir}/fixinc_list ] ; then
    echo "$me: ${itoolsdatadir}/fixinc_list does not exist." >&2
    echo "  That file is installed by gcc's \`install-mkheaders'.  Without it" >&2
    echo "  there is no multilib list to loop over, and fixing only the" >&2
    echo "  top-level directory would leave every non-default multilib with" >&2
    echo "  unfixed headers -- silently." >&2
    exit 1
fi

# `incdir' IS ABOUT TO BE EMPTIED, and it is now caller-supplied, so check it
# before trusting it to `rm -rf'.  When it was always <libdir>/gcc/<ver>/<target>
# it could not name a short path; an option can.  Require an absolute path at
# least three components deep -- enough to exclude `/', `/usr' and `/usr/lib'.
case ${incdir} in
    /*) ;;
    *)  echo "$me: --incdir must be an absolute path, got \`${incdir}'." >&2
	exit 1 ;;
esac
case ${incdir} in
    /*/*/*) ;;
    *)  echo "$me: refusing to \`rm -rf' inside \`${incdir}'." >&2
	echo "  --incdir is emptied before it is written, so it must be a" >&2
	echo "  directory that exists to hold fixed headers and nothing else." >&2
	exit 1 ;;
esac

# THE HEADER DIRECTORY MUST ACTUALLY BE READ, AND THAT MUST BE CHECKED HERE.
#
# MEASURED: pointed at a directory with no headers in it -- or at one that does
# not exist -- this script exited 0 and wrote an include-fixed containing
# limits.h, syslimits.h and README, every byte of it copied out of
# ${itoolsdatadir} and ${itoolsdir} WITHOUT THE HEADER DIRECTORY EVER BEING
# OPENED.  fixinc.sh itself is happy to fix nothing.  So the output of a run
# against a wrong --headers was byte-identical to the output of a correct run
# against a libc needing no hacks.
#
# The checks above are for ABSENT answers; this one is for a WRONG one, and
# "the option was given" was being read as "the option was right".
#
# THERE ARE THREE OUTCOMES, NOT TWO, and the reason this check is shaped the
# way it is:
#
#   (a) headers read, no fixes needed -- SUCCESS.  armv6l glibc 2.42 needs no
#       fixincludes hacks at all, so nothing in its include-fixed is derived
#       from its headers.  A check demanding derived OUTPUT fails that correct
#       run; one demanding readable INPUT does not.  The fix count is printed
#       at the end so that zero is a visible number, not an implication.
#   (b) headers read, fixes applied -- SUCCESS.
#   (c) header directory absent, empty of headers, or unreadable -- FAILURE,
#       naming the directory.
#
# Hence: check the INPUT, count the OUTPUT, assert nothing about the count.
#
# This runs BEFORE the `rm -rf' below, so a rejected run leaves --incdir
# untouched rather than emptying it and then refusing to refill it.
sysheaders_read="${isysroot}${sysheaders}"
if [ ! -d "${sysheaders_read}" ] ; then
    echo "$me: --headers directory \`${sysheaders_read}' does not exist." >&2
    echo "  Those are supposed to be $target's system headers.  Refusing to" >&2
    echo "  continue: fixincludes would read nothing, find nothing to fix," >&2
    echo "  and this script would still write an include-fixed of files" >&2
    echo "  copied from ${itoolsdatadir} -- output indistinguishable from a" >&2
    echo "  correct run over a libc that needs no fixes." >&2
    exit 1
fi
if [ ! -r "${sysheaders_read}" ] || [ ! -x "${sysheaders_read}" ] ; then
    echo "$me: --headers directory \`${sysheaders_read}' is not readable." >&2
    echo "  fixincludes cannot see $target's headers through it, and an" >&2
    echo "  unreadable directory fixes exactly as much as an empty one: none," >&2
    echo "  silently." >&2
    exit 1
fi
if [ -z "`find \"${sysheaders_read}\" -name '*.h' -print 2>/dev/null | sed -n 1p`" ] ; then
    echo "$me: --headers directory \`${sysheaders_read}' contains no headers." >&2
    echo "  Nothing matching \`*.h' anywhere under it, so there is nothing of" >&2
    echo "  $target's for fixincludes to read.  This is case (c) above -- a" >&2
    echo "  wrong --headers -- and it is rejected rather than allowed to" >&2
    echo "  produce the same include-fixed a correct zero-fix run produces." >&2
    exit 1
fi

# `cd' MUST BE CHECKED: unchecked, a missing itoolsdir left this running in the
# caller's cwd, where the fixinc.sh invocation below would find no fixincl and
# the failure would name neither directory.
cd ${itoolsdir} || {
    echo "$me: cannot cd to \`${itoolsdir}'." >&2
    echo "  That is where fixincl and fixinc.sh were installed; pass" >&2
    echo "  --itoolsdir=DIR if they are somewhere else." >&2
    exit 1
}
rm -rf ${incdir}/*

for shell in $CONFIG_SHELL $SHELL @SHELL@ /bin/sh ""; do
  if { test -x $shell || test -x $shell.exe; } \
  && $shell $mkinstalldirs > /dev/null 2>&1; then
    mkinstalldirs="$shell $mkinstalldirs"
    break
  elif test x$shell = x; then
    if $mkinstalldirs > /dev/null 2>&1; then
      break
    elif test ! -f $mkinstalldirs; then
      echo mkheaders: could not find $mkinstalldirs >&2
      exit 1
    else
      echo mkheaders: please rerun with CONFIG_SHELL set to a working Bourne shell >&2
      exit 1
    fi
  fi
done

# macro_list: the macros the preprocessor predefines for THIS target.  gcc's
# build used to make it, with `$(GCC_FOR_TARGET) -E -dM', and on a compiler
# with no target selected that died with an ICE inside a pipeline -- so the
# build carried on and shipped an EMPTY list, which fixinc.sh reads as "the
# compiler predefines nothing".  It is a per-target set and belongs here, next
# to its only consumer, where a target has actually been named.
macro_list=${macro_list_in}
if [ -z "$macro_list" ] ; then
    if [ -z "$gcc_cmd" ] ; then
	echo "$me: neither --gcc=CMD nor --macro-list=FILE given." >&2
	echo "  fixinc.sh needs the set of macros the preprocessor predefines" >&2
	echo "  for $target, so that it does not rename one of them.  An empty" >&2
	echo "  or absent list is not a safe default: it reads as \"nothing is" >&2
	echo "  predefined\" and changes which fixes fire." >&2
	exit 1
    fi
    macro_list=`pwd`/macro_list.${target}
    echo | $gcc_cmd -nostdinc -E -dM - | \
      sed -n -e 's/^#define \([^_][a-zA-Z0-9_]*\).*/\1/p' \
	     -e 's/^#define \(_[^_A-Z][a-zA-Z0-9_]*\).*/\1/p' | \
      sort -u > ${macro_list}.tmp
    # NOT a pipeline whose status is `sort''s.  That is exactly how the old
    # rule shipped an empty list with exit 0.
    if [ ! -s ${macro_list}.tmp ] ; then
	echo "$me: '$gcc_cmd -E -dM' produced no predefined macros for $target." >&2
	echo "  Refusing to fix headers against an empty macro_list." >&2
	rm -f ${macro_list}.tmp
	exit 1
    fi
    mv ${macro_list}.tmp ${macro_list}
fi

# COUNT THE FIXES, DO NOT ASSERT ON THEM.  Zero is a legitimate answer (case
# (a) above), so this number is reported, never required to be non-zero.  It is
# counted per multilib, immediately after fixinc.sh runs and BEFORE the
# unconditional limits.h/syslimits.h copies below, so it counts only what was
# derived from ${sysheaders_read}.
nfixed=0

for ml in `cat ${itoolsdatadir}/fixinc_list`; do
  sysroot_headers_suffix=`echo ${ml} | sed -e 's/;.*$//'`
  multi_dir=`echo ${ml} | sed -e 's/^[^;]*;//'`
  subincdir=${incdir}${multi_dir}
  ${mkinstalldirs} ${subincdir}

  TARGET_MACHINE="${target}" target_canonical="${target}" \
      MACRO_LIST="${macro_list}" \
      $shell ./fixinc.sh ${subincdir} \
      ${sysheaders_read} ${other_dirs}
  nfixed=`expr ${nfixed} + \`find ${subincdir} -name '*.h' -print | wc -l\``
  rm -f ${subincdir}/syslimits.h
  if [ -f ${subincdir}/limits.h ]; then
    mv ${subincdir}/limits.h ${subincdir}/syslimits.h
  else
    cp ${itoolsdatadir}/gsyslimits.h ${subincdir}/syslimits.h
  fi

  cp ${itoolsdatadir}/include${multi_dir}/limits.h ${subincdir}/limits.h
done

if [ -f ${itoolsdir}/README-fixinc ] ; then
  cp ${itoolsdir}/README-fixinc ${incdir}/README
  chmod a+r ${incdir}/README
fi

# THE DIRECTORY EXISTS NOW, AND ONLY NOW MAY ANYTHING POINT AT IT.
#
# cc1 finds it through the `fixed_include_dir' key of ${target}'s config file,
# not through a path compiled into cppdefault.cc -- the compiled-in default is
# "" and the entry is dropped from the include search path, so a compiler that
# has not had mkheaders run for a target does not advertise fixed headers it
# has not got.  Emitting the key is target-specs' job, because target-specs is
# the single writer of that file and two writers is how a target comes to read
# a stale answer.
cat <<EOF
mkheaders: wrote ${target}'s fixed headers to
  ${incdir}
  ${nfixed} header(s) fixed from ${sysheaders_read}.
  (Zero is a legitimate result -- a modern libc may need no hacks.  It is
  printed because "fixed nothing" and "read nothing" used to look the same;
  a --headers that could not be read is now rejected before this point.)
Nothing searches them yet.  Give ${target}'s config file the key, via the one
program that writes it:
  target-specs/configure --with-target=${target} \\
      --with-fixed-include-dir=${incdir} ...
EOF
