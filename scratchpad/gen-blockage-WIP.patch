+/* THIS FORWARDER WAS DESCRIBED IN THIS COMMENT AND IN gensupport.cc FOR A
+   WHILE BEFORE IT EXISTED, AND ITS ABSENCE WAS LIVE WRONG CODE.
+
+   `emit-rtl.h' declares `gen_blockage' unconditionally; `emit-rtl.cc' defines
+   it under `#if !HAVE_blockage'; the middle end (builtins.cc, explow.cc,
+   function.cc) calls the bare name.  With no forwarder here, the bare name was
+   supplied by the PRIMARY's un-namespaced `insn-emit-1.o' -- i386's expander
+   -- and `explow.o' bound to it for every target.
+
+   That is not a naming problem.  `UNSPECV_BLOCKAGE' is 1 in
+   insn-constants-i386.h and 5 in insn-constants-aarch64.h, so an aarch64
+   compilation emitted an `unspec_volatile' numbered 1 while aarch64's own
+   recog matches blockage at 5.  No link error and no diagnostic: the two
+   patterns have the same shape and differ only in a number that means
+   different things in the two vocabularies.  Shared numbering, two
+   authorities, later one wins -- this branch's signature failure, reached
+   through a function nobody had checked was chosen.  */
+rtx
+gen_blockage (void)
+{
+  return mt_in_force ("gen_blockage")->gen_blockage ();
+}
+
 #if CHECKING_P
 void
 verify_reg_names_in_constraints (void)
