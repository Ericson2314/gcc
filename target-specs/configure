ts_vms_debug=no
case ${target} in
  alpha*-dec-*vms* | ia64-hp-*vms*) ts_vms_debug=yes ;;
esac

case ${target} in
  mips*-*-* | loongarch*-*-* | *-*-hpux*)
    if "$gcc_cv_as" -v < /dev/null 2>&1 | grep GNU > /dev/null; then :; else
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: $target requires the GNU assembler; $gcc_cv_as does not identify as one" >&5
$as_echo "$as_me: WARNING: $target requires the GNU assembler; $gcc_cv_as does not identify as one" >&2;}
    fi
    ;;
  amdgcn-* | gcn-*)
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking llvm assembler version" >&5
$as_echo_n "checking llvm assembler version... " >&6; }
    gcc_cv_as_version=`"$gcc_cv_as" --version 2>&1 | sed -ne '/version/s/.* \([0-9]\)/\1/p' || echo error`
    case "$gcc_cv_as_version" in
      13.0.[1-9]* | 13.[1-9]* | 1[4-9]* | [2-9][0-9]* | [1-9][0-9][0-9]*)
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_version, ok" >&5
$as_echo "$gcc_cv_as_version, ok" >&6; } ;;
      *)
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_version" >&5
$as_echo "$gcc_cv_as_version" >&6; }
        { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: amdgcn requires LLVM 13.0.1 or later" >&5
$as_echo "$as_me: WARNING: amdgcn requires LLVM 13.0.1 or later" >&2;} ;;
    esac
    ;;
esac


ts_bool () {
  if test x"$1" = xyes; then echo 1; else echo 0; fi
}

