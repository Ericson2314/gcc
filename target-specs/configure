gcc_cv_ld_broken_secrel32=no
case $target in
  *-*-mingw* | *-*-cygwin* | *-*-pe | *-*-win32)
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking linker for broken @secrel32 relocations" >&5
$as_echo_n "checking linker for broken @secrel32 relocations... " >&6; }
    if test x"$gcc_cv_objdump" = x; then
      { $as_echo "$as_me:${as_lineno-$LINENO}: result: cannot tell, no objdump" >&5
$as_echo "cannot tell, no objdump" >&6; }
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: cannot check for broken @secrel32 relocations without objdump; see https://gcc.gnu.org/bugzilla/show_bug.cgi?id=80881" >&5
$as_echo "$as_me: WARNING: cannot check for broken @secrel32 relocations without objdump; see https://gcc.gnu.org/bugzilla/show_bug.cgi?id=80881" >&2;}
    else
      { echo '	.text'
        echo 'foo:	nop'
        echo '	.data'
        echo '	.secrel32 foo'; } > conftest.s
      if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1 \
         && "$gcc_cv_ld" -o conftest.exe conftest.o > /dev/null 2>&1; then
        if "$gcc_cv_objdump" -h conftest.exe 2>/dev/null | grep '\.reloc' > /dev/null; then
          gcc_cv_ld_broken_secrel32=yes
        fi
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_ld_broken_secrel32" >&5
$as_echo "$gcc_cv_ld_broken_secrel32" >&6; }
      else
        { $as_echo "$as_me:${as_lineno-$LINENO}: result: cannot tell, test link failed" >&5
$as_echo "cannot tell, test link failed" >&6; }
        { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: could not link the @secrel32 test; see https://gcc.gnu.org/bugzilla/show_bug.cgi?id=80881" >&5
$as_echo "$as_me: WARNING: could not link the @secrel32 test; see https://gcc.gnu.org/bugzilla/show_bug.cgi?id=80881" >&2;}
      fi
      rm -f conftest.s conftest.o conftest.exe
    fi
    if test x"$gcc_cv_ld_broken_secrel32" = xyes; then
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: " >&5
$as_echo "$as_me: WARNING: " >&2;}
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: *** $gcc_cv_ld has broken @secrel32 relocations." >&5
$as_echo "$as_me: WARNING: *** $gcc_cv_ld has broken @secrel32 relocations." >&2;}
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: *** Thread-local storage would be MISCOMPILED with this linker." >&5
$as_echo "$as_me: WARNING: *** Thread-local storage would be MISCOMPILED with this linker." >&2;}
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: *** The compiler will refuse to emit TLS for this target." >&5
$as_echo "$as_me: WARNING: *** The compiler will refuse to emit TLS for this target." >&2;}
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: *** Use a linker with the PR80881 fix (GNU ld 2.44 or later)." >&5
$as_echo "$as_me: WARNING: *** Use a linker with the PR80881 fix (GNU ld 2.44 or later)." >&2;}
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: " >&5
$as_echo "$as_me: WARNING: " >&2;}
    fi
    ;;
esac

link_hardening=
