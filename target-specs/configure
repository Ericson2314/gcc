{ $as_echo "$as_me:${as_lineno-$LINENO}: checking linker for .eh_frame personality relaxation" >&5
$as_echo_n "checking linker for .eh_frame personality relaxation... " >&6; }
gcc_cv_ld_mips_personality_relaxation=no
case $target in
  mips*-*-*)
    cat > conftest.s <<'TSEOF'
	.cfi_startproc
	.cfi_personality 0x80,indirect_ptr
	.ent test
test:
	nop
	.end test
	.cfi_endproc

	.section .data,"aw",@progbits
indirect_ptr:
	.dc.a personality
TSEOF
    if "$gcc_cv_as" -KPIC -o conftest.o conftest.s > /dev/null 2>&1 \
       && "$gcc_cv_ld" -o conftest conftest.o -shared > /dev/null 2>&1 \
       && test x"$gcc_cv_readelf" != x; then
      if "$gcc_cv_readelf" -d conftest 2>&1 | grep TEXTREL > /dev/null 2>&1; then
	:
      elif "$gcc_cv_readelf" --relocs conftest 2>&1 \
	   | grep 'R_MIPS_REL32 *$' > /dev/null 2>&1; then
	:
      else
	gcc_cv_ld_mips_personality_relaxation=yes
      fi
    fi
    rm -f conftest conftest.s conftest.o
    ;;
esac
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_ld_mips_personality_relaxation" >&5
$as_echo "$gcc_cv_ld_mips_personality_relaxation" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking linker for -pie with copy relocations" >&5
$as_echo_n "checking linker for -pie with copy relocations... " >&6; }
gcc_cv_ld_pie_copyreloc=no
if test x"$gcc_cv_ld_pie" = xyes \
   && "$gcc_cv_ld" --help 2>&1 | grep -- '-z text' > /dev/null; then
  gcc_cv_ld_pie_copyreloc=yes
fi
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_ld_pie_copyreloc" >&5
$as_echo "$gcc_cv_ld_pie_copyreloc" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking linker for avr emulations" >&5
$as_echo_n "checking linker for avr emulations... " >&6; }
gcc_cv_ld_avr_avrxmega3_rodata_in_flash=no
gcc_cv_ld_avr_avrxmega2_flmap=no
gcc_cv_ld_avr_avrxmega4_flmap=no
case $target in
  avr-*-*)
    ts_emuls=`"$gcc_cv_ld" -V 2>/dev/null`
    if echo "$ts_emuls" | grep avrxmega3 > /dev/null; then
                  gcc_cv_ld_avr_avrxmega3_rodata_in_flash=yes
    fi
    if echo "$ts_emuls" | grep avrxmega2_flmap > /dev/null; then
      gcc_cv_ld_avr_avrxmega2_flmap=yes
    fi
    if echo "$ts_emuls" | grep avrxmega4_flmap > /dev/null; then
      gcc_cv_ld_avr_avrxmega4_flmap=yes
    fi
    ;;
esac
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_ld_avr_avrxmega3_rodata_in_flash/$gcc_cv_ld_avr_avrxmega2_flmap/$gcc_cv_ld_avr_avrxmega4_flmap" >&5
$as_echo "$gcc_cv_ld_avr_avrxmega3_rodata_in_flash/$gcc_cv_ld_avr_avrxmega2_flmap/$gcc_cv_ld_avr_avrxmega4_flmap" >&6; }


ts_asm_ok () {
  # $1 is the assembly text; assemble it and report yes/no.
  echo "$1" > conftest.s
  if "$gcc_cv_as" $ts_as_flags -o conftest.o conftest.s > /dev/null 2>&1; then
    echo yes
  else
    echo no
  fi
}

ts_as_flags=

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for cfi directives" >&5
$as_echo_n "checking assembler for cfi directives... " >&6; }
gcc_cv_as_cfi_directive=`ts_asm_ok '	.text
	.cfi_startproc
	.cfi_offset 0, 0
	.cfi_same_value 1
	.cfi_def_cfa 1, 2
	.cfi_escape 1, 2, 3, 4, 5
	.cfi_endproc'`
case "$target" in
  hppa*-*-hpux*)
    gcc_cv_as_cfi_directive=no ;;
  x86_64-*-darwin* | i?86-*-darwin* | powerpc*-darwin-*)
    gcc_cv_as_cfi_directive=no ;;
  *-*-solaris*)
    if test x"$gcc_cv_ld_ro_rw_mix" = xread-write; then
      :
    elif test x"$gcc_cv_objdump" = x; then
      gcc_cv_as_cfi_directive=no
    else
      # .eh_frame must come out read-write, or GCC and the assembler disagree.
      if "$gcc_cv_objdump" -h conftest.o 2>/dev/null \
	 | sed -e '/.eh_frame/!d' -e N | grep READONLY > /dev/null; then
	gcc_cv_as_cfi_directive=no
      fi
    fi
    ;;
esac
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_cfi_directive" >&5
$as_echo "$gcc_cv_as_cfi_directive" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for working cfi advance" >&5
$as_echo_n "checking assembler for working cfi advance... " >&6; }
gcc_cv_as_cfi_advance_working=no
if test x"$gcc_cv_as_cfi_directive" = xyes && test x"$gcc_cv_objdump" != x; then
  cat > conftest.s <<'TSEOF'
	.text
	.cfi_startproc
	.cfi_adjust_cfa_offset 64
	.skip 75040, 0
	.cfi_adjust_cfa_offset 128
	.cfi_endproc
TSEOF
  if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1 \
     && "$gcc_cv_objdump" -Wf conftest.o 2>/dev/null \
	| grep 'DW_CFA_advance_loc[24]:[ 	][ 	]*75040[ 	]' >/dev/null; then
    gcc_cv_as_cfi_advance_working=yes
  fi
fi
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_cfi_advance_working" >&5
$as_echo "$gcc_cv_as_cfi_advance_working" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .cfi_personality" >&5
$as_echo_n "checking assembler for .cfi_personality... " >&6; }
gcc_cv_as_cfi_personality_directive=`ts_asm_ok '	.text
	.cfi_startproc
	.cfi_personality 0, symbol
	.cfi_endproc'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_cfi_personality_directive" >&5
$as_echo "$gcc_cv_as_cfi_personality_directive" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .cfi_sections" >&5
$as_echo_n "checking assembler for .cfi_sections... " >&6; }
gcc_cv_as_cfi_sections_directive=`ts_asm_ok '	.text
	.cfi_sections .debug_frame, .eh_frame
	.cfi_startproc
	.cfi_endproc'`
case $target in
  *-*-mingw* | *-*-cygwin* | *-*-pe | *-*-win32)
    if test x"$gcc_cv_as_cfi_sections_directive" = xyes; then
      gcc_cv_as_cfi_sections_directive=no
      if test x"$gcc_cv_objdump" != x \
	 && "$gcc_cv_objdump" -j .debug_frame -r conftest.o 2>/dev/null \
	    | grep -i secrel > /dev/null; then
	gcc_cv_as_cfi_sections_directive=yes
      fi
    fi
    ;;
esac
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_cfi_sections_directive" >&5
$as_echo "$gcc_cv_as_cfi_sections_directive" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for AIX .ref" >&5
$as_echo_n "checking assembler for AIX .ref... " >&6; }
gcc_cv_as_aix_ref=`ts_asm_ok '	.csect stuff[rw]
stuff:
	.long 1
	.extern sym
	.ref sym'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_aix_ref" >&5
$as_echo "$gcc_cv_as_aix_ref" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for AIX DWARF location lists" >&5
$as_echo_n "checking assembler for AIX DWARF location lists... " >&6; }
gcc_cv_as_aix_dwloc=`ts_asm_ok '	.dwsect 0xA0000
Lframe..0:
	.vbyte 4,Lframe..0'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_aix_dwloc" >&5
$as_echo "$gcc_cv_as_aix_dwloc" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .hidden" >&5
$as_echo_n "checking assembler for .hidden... " >&6; }
case "$target" in
  *-*-aix*) ts_hidden_s='	.globl foobar,hidden' ;;
  *)        ts_hidden_s='	.hidden foobar
foobar:' ;;
esac
gcc_cv_as_hidden=`ts_asm_ok "$ts_hidden_s"`
case "$target" in
    *-*-darwin*) gcc_cv_as_hidden=yes ;;
esac
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_hidden" >&5
$as_echo "$gcc_cv_as_hidden" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .gnu_attribute" >&5
$as_echo_n "checking assembler for .gnu_attribute... " >&6; }
gcc_cv_as_gnu_attribute=`ts_asm_ok '	.gnu_attribute 4,1'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_gnu_attribute" >&5
$as_echo "$gcc_cv_as_gnu_attribute" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .loc is_stmt" >&5
$as_echo_n "checking assembler for .loc is_stmt... " >&6; }
gcc_cv_as_is_stmt=`ts_asm_ok '	.text
	.file 1 "conf.c"
	.loc 1 1 0 is_stmt 1'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_is_stmt" >&5
$as_echo "$gcc_cv_as_is_stmt" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .loc discriminator" >&5
$as_echo_n "checking assembler for .loc discriminator... " >&6; }
gcc_cv_as_discriminator=`ts_asm_ok '	.text
	.file 1 "conf.c"
	.loc 1 1 0 discriminator 1'`
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_discriminator" >&5
$as_echo "$gcc_cv_as_discriminator" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for tolerance to line number 0" >&5
$as_echo_n "checking assembler for tolerance to line number 0... " >&6; }
gcc_cv_as_line_zero=no
{ echo '# 1 "test.s" 1'; echo '# 0 "" 2'; } > conftest.s
if "$gcc_cv_as" -o conftest.o conftest.s 2>conftest.out > /dev/null \
   && test "x`cat conftest.out`" = x; then
  gcc_cv_as_line_zero=yes
fi
rm -f conftest.out
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_line_zero" >&5
$as_echo "$gcc_cv_as_line_zero" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for dwarf2 .file/.loc" >&5
$as_echo_n "checking assembler for dwarf2 .file/.loc... " >&6; }
gcc_cv_as_dwarf2_debug_line=no
cat > conftest.s <<'TSEOF'
	.file 1 "conftest.s"
	.loc 1 3 0
	nop
TSEOF
if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1; then
  if test x"$gcc_cv_objdump" != x; then
    "$gcc_cv_objdump" -h conftest.o 2>/dev/null | grep debug_line > /dev/null 2>&1 \
      && gcc_cv_as_dwarf2_debug_line=yes
  else
    gcc_cv_as_dwarf2_debug_line=yes
  fi
fi
gcc_cv_as_dwarf2_file_buggy=`ts_asm_ok '	.file 1 "foo.s"
	.file 1 "bar.s"'`
if test x"$gcc_cv_as_dwarf2_file_buggy" = xyes; then
  # Accepting the duplicate index is the bug.
  gcc_cv_as_dwarf2_debug_line=no
fi
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_dwarf2_debug_line" >&5
$as_echo "$gcc_cv_as_dwarf2_debug_line" >&6; }

{ $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .loc views" >&5
$as_echo_n "checking assembler for .loc views... " >&6; }
gcc_cv_as_dwarf2_debug_view=no
if test x"$gcc_cv_as_dwarf2_debug_line" = xyes \
   && test x"$gcc_cv_as_leb128" = xyes; then
  gcc_cv_as_dwarf2_debug_view=`ts_asm_ok '	.file 1 "conftest.s"
	.loc 1 3 0 view .LVU1
	nop
	.data
	.uleb128 .LVU1
	.uleb128 .LVU1'`
fi
{ $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_dwarf2_debug_view" >&5
$as_echo "$gcc_cv_as_dwarf2_debug_view" >&6; }

rm -f conftest.s conftest.o


gcc_cv_as_aarch64_mabi=no
gcc_cv_as_aarch64_picreloc=no
gcc_cv_as_aarch64_aeabi=no
