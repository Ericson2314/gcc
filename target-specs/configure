  if test -d "$ts_tools_dir"; then
    PATH="$ts_tools_dir:$PATH"
    export PATH
    { $as_echo "$as_me:${as_lineno-$LINENO}: probing with $ts_tools_dir at the front of PATH" >&5
$as_echo "$as_me: probing with $ts_tools_dir at the front of PATH" >&6;}
  else
    as_fn_error $? "--with-tools-dir=$ts_tools_dir is not a directory" "$LINENO" 5
  fi
