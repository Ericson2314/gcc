$as_echo "$gcc_cv_as_aarch64_mabi" >&6; }

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for -fpic relocs" >&5
$as_echo_n "checking assembler for -fpic relocs... " >&6; }
    cat > conftest.s <<'TSEOF'
