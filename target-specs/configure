TSEOF
    if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_aarch64_aeabi=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_aarch64_aeabi" >&5
$as_echo "$gcc_cv_as_aarch64_aeabi" >&6; }

    rm -f conftest.s conftest.o
    ;;
  *)
                ;;
esac


gcc_cv_as_mips_nan=no
gcc_cv_as_micromips_support=no
gcc_cv_as_mips_dspr1_mult=no
gcc_cv_as_mips_explicit_relocs=no
gcc_cv_as_mips_explicit_relocs_pcrel=no
gcc_cv_as_ld_mips_jalr_reloc=no
gcc_cv_as_mips_dot_module=no
case ${target} in
  mips*-*-*)
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for -mnan= support" >&5
$as_echo_n "checking assembler for -mnan= support... " >&6; }
    echo '	.text' > conftest.s
    if "$gcc_cv_as" -mnan=2008 -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_mips_nan=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_mips_nan" >&5
$as_echo "$gcc_cv_as_mips_nan" >&6; }

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .micromips support" >&5
$as_echo_n "checking assembler for .micromips support... " >&6; }
    echo '	.set micromips' > conftest.s
    if "$gcc_cv_as" $fw_as_opt -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_micromips_support=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_micromips_support" >&5
$as_echo "$gcc_cv_as_micromips_support" >&6; }

                            { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for DSPR1 mult with four accumulators" >&5
$as_echo_n "checking assembler for DSPR1 mult with four accumulators... " >&6; }
    cat > conftest.s <<'TSEOF'
	.set	mips32r2
	.set	nodspr2
	.set	dsp
	madd	$ac3,$4,$5
	maddu	$ac3,$4,$5
	msub	$ac3,$4,$5
	msubu	$ac3,$4,$5
	mult	$ac3,$4,$5
	multu	$ac3,$4,$5
TSEOF
    if "$gcc_cv_as" -32 -mdspr2 -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_mips_dspr1_mult=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_mips_dspr1_mult" >&5
$as_echo "$gcc_cv_as_mips_dspr1_mult" >&6; }

                        { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for %pcrel_hi/%pcrel_lo" >&5
$as_echo_n "checking assembler for %pcrel_hi/%pcrel_lo... " >&6; }
    echo '	lui $4,%pcrel_hi(foo)' > conftest.s
    if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_mips_explicit_relocs_pcrel=yes
      gcc_cv_as_mips_explicit_relocs=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_mips_explicit_relocs_pcrel" >&5
$as_echo "$gcc_cv_as_mips_explicit_relocs_pcrel" >&6; }

    if test x"$gcc_cv_as_mips_explicit_relocs" != xyes; then
      { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for %gp_rel" >&5
$as_echo_n "checking assembler for %gp_rel... " >&6; }
      echo '	lw $4,%gp_rel(foo)($4)' > conftest.s
      if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1; then
	gcc_cv_as_mips_explicit_relocs=yes
      fi
      { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_mips_explicit_relocs" >&5
$as_echo "$gcc_cv_as_mips_explicit_relocs" >&6; }
    fi

                { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler and linker for explicit JALR relocation" >&5
$as_echo_n "checking assembler and linker for explicit JALR relocation... " >&6; }
    if test x"$gcc_cv_as_mips_explicit_relocs" = xyes \
       && test x"$gcc_cv_objdump" != x; then
      cat > conftest.s <<'TSEOF'
	.ent x
x:	lw $2,%got_disp(y)($3)
	lw $25,%call16(y)($28)
	.reloc	1f,R_MIPS_JALR,y
1:	jalr $25
	.reloc	1f,R_MIPS_JALR,x
1:	jalr $25
	.end x
TSEOF
      if "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1 \
	 && "$gcc_cv_ld" -shared -o conftest.so conftest.o > /dev/null 2>&1; then
	if "$gcc_cv_objdump" -d conftest.so | grep jalr > /dev/null 2>&1 \
	   && "$gcc_cv_objdump" -d conftest.so | grep "bal.*<x>" > /dev/null 2>&1; then
	  gcc_cv_as_ld_mips_jalr_reloc=yes
	fi
      fi
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_ld_mips_jalr_reloc" >&5
$as_echo "$gcc_cv_as_ld_mips_jalr_reloc" >&6; }

                            { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for .module support" >&5
$as_echo_n "checking assembler for .module support... " >&6; }
    cat > conftest.s <<'TSEOF'
	.module mips2
	.module fp=xx
TSEOF
    if "$gcc_cv_as" -32 -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_mips_dot_module=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_mips_dot_module" >&5
$as_echo "$gcc_cv_as_mips_dot_module" >&6; }

    rm -f conftest.s conftest.o
    ;;
esac

