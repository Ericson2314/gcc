{ $as_echo "$as_me:${as_lineno-$LINENO}: checking linker for read-only/read-write section mixing" >&5
$as_echo_n "checking linker for read-only/read-write section mixing... " >&6; }
gcc_cv_ld_ro_rw_mix=unknown
echo '.section myfoosect, "a"' > conftest1.s
echo '.section myfoosect, "aw"' > conftest2.s
