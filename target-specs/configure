  link_hardening="-z now"
fi
if test x"$gcc_cv_ld_relro" = xyes; then
  link_hardening="${link_hardening} -z relro"
fi

case $target in
  sparc*-*-*)
    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for -relax" >&5
$as_echo_n "checking assembler for -relax... " >&6; }
    gcc_cv_as_sparc_relax=no
    echo '	.text' > conftest.s
    if "$gcc_cv_as" -relax -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_sparc_relax=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_sparc_relax" >&5
$as_echo "$gcc_cv_as_sparc_relax" >&6; }

                { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for offsetable %lo()" >&5
$as_echo_n "checking assembler for offsetable %lo()... " >&6; }
    gcc_cv_as_sparc_offsetable_lo10=no
    if test x"$gcc_cv_objdump" != x; then
      { echo '.text'
        echo '	or %g1, %lo(ab) + 12, %g1'
        echo '	or %g1, %lo(ab + 12), %g1'; } > conftest.s
      if "$gcc_cv_as" -xarch=v9 -o conftest.o conftest.s > /dev/null 2>&1 \
         && "$gcc_cv_objdump" -s -j .text conftest.o 2>/dev/null \
            | grep ' 82106000 82106000' > /dev/null 2>&1; then
        gcc_cv_as_sparc_offsetable_lo10=yes
      fi
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_sparc_offsetable_lo10" >&5
$as_echo "$gcc_cv_as_sparc_offsetable_lo10" >&6; }

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for LEON instructions" >&5
$as_echo_n "checking assembler for LEON instructions... " >&6; }
    gcc_cv_as_sparc_leon=no
    { echo '.text'
      echo '	.register %g2, #scratch'
      echo '	.register %g3, #scratch'
      echo '	.align 4'
      echo '	smac %g2, %g3, %g1'
      echo '	umac %g2, %g3, %g1'
      echo '	casa %g2 0xb, %g3, %g1'; } > conftest.s
    if "$gcc_cv_as" -Aleon -o conftest.o conftest.s > /dev/null 2>&1; then
      gcc_cv_as_sparc_leon=yes
    fi
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_sparc_leon" >&5
$as_echo "$gcc_cv_as_sparc_leon" >&6; }
    if test x"$gcc_cv_as_sparc_leon" != xyes; then
      { $as_echo "$as_me:${as_lineno-$LINENO}: WARNING: $gcc_cv_as does not accept -Aleon; GCC emits it unconditionally, so override the asm spec for this target" >&5
$as_echo "$as_me: WARNING: $gcc_cv_as does not accept -Aleon; GCC emits it unconditionally, so override the asm spec for this target" >&2;}
    fi
    rm -f conftest.s conftest.o
    ;;
esac

