    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_ix86_tls_get_addr_via_got" >&5
$as_echo "$gcc_cv_as_ix86_tls_get_addr_via_got" >&6; }

                        { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler and linker for R_386_GOT32X" >&5
$as_echo_n "checking assembler and linker for R_386_GOT32X... " >&6; }
    cat > conftest.s <<'TSEOF'
	.data
bar:
	.byte 1
	.text
	.global _start
_start:
	cmpl $0, bar@GOT
	jmp *_start@GOT
TSEOF
    if test x"$gcc_cv_ld" != x && test x"$gcc_cv_objdump" != x \
       && test x"$gcc_cv_readelf" != x \
       && "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1 \
       && "$gcc_cv_readelf" --relocs --wide conftest.o 2>&1 \
	  | grep R_386_GOT32X > /dev/null 2>&1 \
       && "$gcc_cv_ld" -o conftest conftest.o > /dev/null 2>&1; then
                  if "$gcc_cv_objdump" -dw conftest 2>&1 | grep 0xffffff > /dev/null 2>&1
      then :; else
	gcc_cv_as_ix86_got32x=yes
      fi
    fi
    rm -f conftest conftest.o conftest.s
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_ix86_got32x" >&5
$as_echo "$gcc_cv_as_ix86_got32x" >&6; }

    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler and linker for R_X86_64_CODE_6_GOTTPOFF" >&5
$as_echo_n "checking assembler and linker for R_X86_64_CODE_6_GOTTPOFF... " >&6; }
    cat > conftest.s <<'TSEOF'
	.text
	.globl	_start
	.type _start, @function
_start:
	addq	%r23,foo@GOTTPOFF(%rip), %r15
	.section .tdata,"awT",@progbits
	.type foo, @object
foo:
	.quad 0
TSEOF
    if test x"$gcc_cv_ld" != x && test x"$gcc_cv_objdump" != x \
       && test x"$gcc_cv_readelf" != x \
       && "$gcc_cv_as" -o conftest.o conftest.s > /dev/null 2>&1 \
       && "$gcc_cv_readelf" --relocs --wide conftest.o 2>&1 \
	  | grep R_X86_64_CODE_6_GOTTPOFF > /dev/null 2>&1 \
       && "$gcc_cv_ld" -o conftest conftest.o > /dev/null 2>&1; then
      if "$gcc_cv_objdump" -dw conftest 2>&1 \
	 | grep "add \+\$0xf\+8,%r23,%r15" > /dev/null 2>&1; then
	gcc_cv_as_x86_64_code_6_gottpoff=yes
      fi
    fi
    rm -f conftest conftest.o conftest.s
    { $as_echo "$as_me:${as_lineno-$LINENO}: result: $gcc_cv_as_x86_64_code_6_gottpoff" >&5
$as_echo "$gcc_cv_as_x86_64_code_6_gottpoff" >&6; }

                    { $as_echo "$as_me:${as_lineno-$LINENO}: checking assembler for @GOTOFF in a data section" >&5
$as_echo_n "checking assembler for @GOTOFF in a data section... " >&6; }
gcc_cv_as_ix86_gotoff_in_data=no
if test x"$gcc_cv_as" != x; then
  cat > conftest.s <<'TS_ASEOF'
