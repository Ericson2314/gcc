#!/bin/sh

#
# This script computes the various flags needed to run GNU C++ testsuites
# (compiler specific as well as library specific). 
#
# Written by Benjamin Kosnik <bkoz@redhat.com>
#            Gabriel Dos Reis <gdr@codesourcery.com>
#

# Print a message saying how this script is intended to be invoked
print_usage() {
    cat <<EOF
Usage: 
    testsuite_flags --install-includes
		    --build-includes
		    --build-cxx
		    --build-cc
		    --install-cxx
		    --cxxflags
		    --cxxldflags
		    --cxxpchflags
		    --cxxvtvflags

EOF
}

# Establish configure-generated directory structure.
BUILD_DIR=@glibcxx_builddir@
SRC_DIR=@glibcxx_srcdir@
PREFIX_DIR=@glibcxx_prefixdir@
query=$1

case ${query} in
    --install-includes)
      INCLUDES="-I${SRC_DIR}/testsuite/util"
      echo ${INCLUDES}
      ;;
    --build-includes)
      INCLUDES="-nostdinc++ @GLIBCXX_INCLUDES@ 
                -I${SRC_DIR}/include/backward -I${SRC_DIR}/testsuite/util"
      echo ${INCLUDES}
      ;;
    --install-cxx)
      CXX=${PREFIX_DIR}/bin/g++
      echo ${CXX}
      ;;
    --build-cxx)
      # @CXX@ here is RAW_CXX_FOR_TARGET: it runs the build tree's C driver.
      # Turn it into the C++ driver.  Both drivers in the build tree are named
      # by ONE rule -- the C++ one is the C one with the trailing `gcc'
      # replaced by `g++' -- which covers `xgcc' -> `xg++' and, now that the
      # build tree also carries the driver under its installed name,
      # `<triple>-gcc' -> `<triple>-g++'.
      #
      # This is a rewrite of a command string, so its failure mode is silence:
      # if the pattern does not match, the C driver is returned and the whole
      # C++ testsuite is compiled by it, with no diagnostic anywhere.  The old
      # form matched the literal `gcc/xgcc ' and did exactly that the moment
      # the driver was named anything else.  Hence both the general rule and
      # the check below -- do not replace either with a literal.
      CXX_build="@CXX@"
      CXX=`echo "$CXX_build" | sed 's,\(/\)\([^/ ]*\)gcc \(.*\)$,\1\2g++ \3,'`
      case "$CXX" in
        *g++\ *) ;;
        *) echo "testsuite_flags: --build-cxx: cannot derive the C++ driver's" \
                "name from [$CXX_build]" 1>&2
           exit 1 ;;
      esac
      echo ${CXX}
      ;;
    --build-cc)
      CC_build="@CC@"
      CC="$CC_build"
      echo ${CC}
      ;;
    --cxxflags)
      CXXFLAGS_default="-fmessage-length=0 -fno-show-column"
      CXXFLAGS_config="@SECTION_FLAGS@ @EXTRA_CXX_FLAGS@"
      echo ${CXXFLAGS_default} ${CXXFLAGS_config} 
      ;;
    --cxxvtvflags)
      CXXFLAGS_vtv="@VTV_CXXFLAGS@"
      LDFLAGS_vtv="@VTV_CXXLINKFLAGS@"
      echo ${CXXFLAGS_vtv} ${LDFLAGS_vtv}
      ;;
    --cxxparallelflags)
      CXXFLAGS_parallel="-D_GLIBCXX_PARALLEL -fopenmp
			 -B${BUILD_DIR}/../libgomp 
                         -I${BUILD_DIR}/../libgomp 
			 -L${BUILD_DIR}/../libgomp/.libs -lgomp"
      echo ${CXXFLAGS_parallel}
      ;;
    --cxxpchflags)
      PCHFLAGS="@glibcxx_PCHFLAGS@"
      echo ${PCHFLAGS}
      ;;
    --cxxldflags)
      FS_LDFLAGS=
      EXP_LDFLAGS=
      if [ -d ${BUILD_DIR}/src/filesystem/.libs ]; then
        FS_LDFLAGS=-L${BUILD_DIR}/src/filesystem/.libs
      fi
      if [ -d ${BUILD_DIR}/src/experimental/.libs ]; then
        EXP_LDFLAGS=-L${BUILD_DIR}/src/experimental/.libs
      fi
      SECTIONLDFLAGS="@SECTION_LDFLAGS@ @LIBICONV@ $FS_LDFLAGS $EXP_LDFLAGS"
      echo ${SECTIONLDFLAGS}
      ;;
    *)
      print_usage
      ;;
esac

exit 0
