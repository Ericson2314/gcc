# Headers generated from gcn-devices.def.  Factored out of t-gcn-hsa so that
# a multi-target build -- which includes no single target's tmake_file -- can
# generate them too; see gen-multi-target-md.awk.

gcn-device-macros.h: $(srcdir)/config/gcn/gcn-devices.def $(srcdir)/config/gcn/gen-gcn-device-macros.awk
	$(AWK) -f $(srcdir)/config/gcn/gen-gcn-device-macros.awk $< > $@
generated_files += gcn-device-macros.h

gcn-common.o: gcn-device-macros.h
