TM_H += $(srcdir)/config/s390/s390-builtins.def
TM_H += $(srcdir)/config/s390/s390-builtin-types.def
PASSES_EXTRA += $(srcdir)/config/s390/s390-passes.def
EXTRA_GTYPE_DEPS += ./s390-gen-builtins.h

s390-c.o: $(srcdir)/config/s390/s390-c.cc \
  $(srcdir)/config/s390/s390-protos.h $(CONFIG_H) $(SYSTEM_H) coretypes.h \
  $(TM_H) $(TREE_H) $(TM_P_H) $(FLAGS_H) $(C_COMMON_H) $(GGC_H) \
  $(TARGET_H) $(TARGET_DEF_H) $(CPPLIB_H) $(C_PRAGMA_H)
	$(COMPILER) -c $(ALL_COMPILERFLAGS) $(ALL_CPPFLAGS) $(INCLUDES) \
		$(srcdir)/config/s390/s390-c.cc

s390-d.o: $(srcdir)/config/s390/s390-d.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

include $(srcdir)/config/s390/t-s390-headers

# s390's sources have been converted to the 2-coefficient poly_int discipline:
# they say known_lt/maybe_ne/to_constant () rather than relying on the
# fixed-size shorthand that target code gets while NUM_POLY_INT_COEFFS is 1.
# Ask for the discipline now, so that the eventual flip to 2 coefficients is a
# no-op here.  See coretypes.h.
#
# PER OBJECT, not T_CFLAGS -- T_CFLAGS is one variable for the whole gcc/
# directory and would hand s390's opt-in to every other back end.  See the
# same comment in config/i386/t-i386 for the full reasoning.
s390_poly_objs = s390.o s390-c.o s390-d.o driver-native.o

$(foreach o,$(s390_poly_objs),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))

# The machine description's conditions are s390 target code too, and they are
# compiled inside the generated insn-* files, whose names differ between a
# single-target build (insn-recog.o) and a multi-target one
# (insn-recog-s390.o).  Match both shapes.
s390_poly_gen = insn-attrtab.o insn-automata.o insn-dfatab.o insn-emit.o \
  insn-enums.o insn-extract.o insn-latencytab.o insn-modes.o insn-opinit.o \
  insn-output.o insn-peep.o insn-preds.o insn-recog.o

$(foreach o,$(s390_poly_gen),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(s390_poly_gen),$(eval CFLAGS-$(o:.o=)-s390.o += -DTARGET_POLY_AWARE))

# insn-emit and insn-recog are split into a configured number of files.  Use
# the Makefile's own lists rather than a pattern: a pattern-specific variable
# propagates to the target's PREREQUISITES and would reach build/genemit.o and
# build/genrecog.o, generators shared by every back end.
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o:.o=)-s390.o += -DTARGET_POLY_AWARE))

# gencondmd is target code -- genconditions.cc writes `#define IN_TARGET_CODE
# 1' into the file it generates -- so it needs the opt-in too.  Only the
# single-target object is named here; gen-multi-target-md.awk flags each
# configured triple, reading the declaration above to decide.  See t-i386.
build/gencondmd.o : T_CFLAGS += -DTARGET_POLY_AWARE
