# Override newlib settings in t-sde and set up for building
# against SDE header files and libraries.

MULTILIB_OPTIONS = EL/EB mips32/mips32r2/mips64/mips64r2 mips16 msoft-float/mno-float/mfp64
MULTILIB_DIRNAMES = el eb mips32 mips32r2 mips64 mips64r2 mips16 sof nof f64
MULTILIB_MATCHES = mips32r2=mips32r3 mips32r2=mips32r5 mips64r2=mips64r3 mips64r2=mips64r5

# Remove stdarg.h and stddef.h from USER_H.
USER_H = $(srcdir)/ginclude/float.h \
         $(srcdir)/ginclude/iso646.h \
         $(srcdir)/ginclude/stdbool.h \
         $(srcdir)/ginclude/varargs.h \
         $(EXTRA_HEADERS)

# "Don't run fixinclude" -- this used to override STMP_FIXINC with a rule of
# its own so that gcc's build skipped fixincludes for SDE.  Both the variable
# and the rule it replaced are gone: gcc's build does not run fixincludes for
# ANY target now, so there is nothing here to opt out of.  A target that wants
# fixed headers gets them from fixincludes/mkheaders after install; one that
# does not, like this one, simply is not given that command.
#
# Deleted rather than left defining a variable nobody reads.  A tmake fragment
# that appears to switch something off while nothing consults it is the shape
# this branch keeps finding: the setting looks respected and is inert.
