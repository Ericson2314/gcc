# i386-builtin-types.inc is included into i386-builtins.h.
# Below are direct users of i386-builtins.h:
i386.o: i386-builtin-types.inc
i386-builtins.o: i386-builtin-types.inc
i386-expand.o: i386-builtin-types.inc
i386-features.o: i386-builtin-types.inc

i386-builtin-types.inc: s-i386-bt ; @true
s-i386-bt: $(srcdir)/config/i386/i386-builtin-types.awk \
  $(srcdir)/config/i386/i386-builtin-types.def
	$(AWK) -f $^ > tmp-bt.inc
	$(SHELL) $(srcdir)/../move-if-change tmp-bt.inc i386-builtin-types.inc
	$(STAMP) $@

# i386's sources have been converted to the 2-coefficient poly_int
# discipline: they say known_lt/maybe_ne/to_constant () rather than relying
# on the fixed-size shorthand that target code gets while
# NUM_POLY_INT_COEFFS is 1.  Ask for the discipline now, so that the
# eventual flip to 2 coefficients is a no-op here.  See coretypes.h.
#
# PER OBJECT, not T_CFLAGS.  T_CFLAGS is one variable for the whole gcc/
# directory, and ALL_CXXFLAGS -- and through it BUILD_CXXFLAGS, so the
# generators too -- begins with it.  In a single-target build that is
# harmless, because the only target code present is i386's.  In a
# multi-target build it is not: the primary target's fragment is the only
# one `-include $(tmake_file)' reads, so i386 being primary handed its
# opt-in to every other back end's objects (arm's gencondmd stopped
# compiling at NEON_ENDIAN_LANE_N), and i386 NOT being primary would have
# withheld the flag from i386's own objects, which no longer build without
# it.  An opt-in that is per back end has to be scoped per object.
i386_poly_objs = i386.o i386-c.o i386-d.o i386-rust.o i386-jit.o \
  i386-options.o i386-builtins.o i386-expand.o i386-features.o \
  x86-tune-sched.o x86-tune-sched-bd.o x86-tune-sched-atom.o \
  x86-tune-sched-core.o driver-i386.o gnu-property.o djgpp.o

$(foreach o,$(i386_poly_objs),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))

# The machine description's conditions are i386 target code too, and they are
# compiled inside the generated insn-* files.  Their names differ between a
# single-target build (insn-recog.o) and a multi-target one
# (insn-recog-i386.o, build/gencondmd-<triple>.o), so match both shapes.
i386_poly_gen = insn-attrtab.o insn-automata.o insn-dfatab.o insn-emit.o \
  insn-enums.o insn-extract.o insn-latencytab.o insn-modes.o insn-opinit.o \
  insn-output.o insn-peep.o insn-preds.o insn-recog.o

$(foreach o,$(i386_poly_gen),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(i386_poly_gen),$(eval CFLAGS-$(o:.o=)-i386.o += -DTARGET_POLY_AWARE))

# insn-emit and insn-recog are split into a configured number of files.  The
# Makefile already names them, and this fragment is included after it, so use
# those lists rather than a pattern: a pattern-specific variable propagates to
# the target's PREREQUISITES, which would hand the flag to build/genemit.o and
# build/genrecog.o -- generators shared by every back end.
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o:.o=)-i386.o += -DTARGET_POLY_AWARE))

# gencondmd is target code -- genconditions.cc writes `#define IN_TARGET_CODE
# 1' into the file it generates -- so it needs the opt-in too.
#
# ONLY the single-target object is named here.  The per-triple ones
# (build/gencondmd-<triple>.o) used to be matched by patterns in this file,
# which was wrong twice over.  A fragment is read only when its back end is
# the PRIMARY target, so those patterns did nothing in exactly the builds that
# needed them; and spelling triples as patterns here duplicated a rule
# gen-multi-target-md.awk already emits.  That generator now reads the
# declaration above and flags each configured triple itself, so both back ends
# are on one mechanism and a triple is spelled in one place.
build/gencondmd.o : T_CFLAGS += -DTARGET_POLY_AWARE
