# Both a target's own tmake_file and the multi-target rules can pull this
# in -- an --enable-targets=all build hosted on this target does both -- and
# including it twice would give every rule below a duplicate recipe.
ifndef t_arm_headers_included
t_arm_headers_included := 1

# Headers generated from arm-cpus.in.  Factored out of t-arm so that a
# multi-target build -- which includes no single target's tmake_file -- can
# generate them too; see gen-multi-target-md.awk.

# WHAT THIS FRAGMENT GENERATES, declared for the readers rather than left to
# be inferred from the rules below.  gen-multi-target-md.awk's scan_hdr_frag
# reads exactly this line; it is the only claim in the tree about these names,
# and a fragment with rules but no `generated_files' is invisible to it.
#
# This fragment had the rules and not the declaration, so nothing depended on
# the headers and a rule nothing depends on is never run.  Measured with 48
# back ends configured: build/gencheck.o died on
# `arm-isa.h: No such file or directory' -- reached through tm.h, options.h and
# config/arm/arm-opts.h, none of which look like arm -- while s-arm-isa sat in
# multi-target-md.mk the whole time.  The other six t-<cpu>-headers fragments
# all carry the line; arm was the one that did not.
#
# arm-cpu-data.h and arm-native.h are deliberately included even though the
# failure named only arm-isa.h: they come from the same generator for the same
# reason, and listing only the name that happened to fail first is how the
# next one gets found by another build.
#
# ON ONE LINE.  scan_hdr_frag matches `generated_files +=' and reads THAT
# physical line; it does not follow a trailing backslash.  Written as a
# continuation, this line put four headers in multi-target-md.mk and silently
# dropped arm-native.h -- the under-read looks exactly like a complete list.
generated_files += arm-cpu.h arm-isa.h arm-cpu-data.h arm-cpu-cdata.h arm-native.h


arm-cpu.h: s-arm-cpu ; @true
s-arm-cpu: $(srcdir)/config/arm/parsecpu.awk \
  $(srcdir)/config/arm/arm-cpus.in
	$(AWK) -f $(srcdir)/config/arm/parsecpu.awk -v cmd=headers \
		$(srcdir)/config/arm/arm-cpus.in > tmp-arm-cpu.h
	$(SHELL) $(srcdir)/../move-if-change tmp-arm-cpu.h arm-cpu.h
	$(STAMP) s-arm-cpu

arm-isa.h: s-arm-isa ; @true
s-arm-isa: $(srcdir)/config/arm/parsecpu.awk \
  $(srcdir)/config/arm/arm-cpus.in
	$(AWK) -f $(srcdir)/config/arm/parsecpu.awk -v cmd=isa \
		$(srcdir)/config/arm/arm-cpus.in > tmp-arm-isa.h
	$(SHELL) $(srcdir)/../move-if-change tmp-arm-isa.h arm-isa.h
	$(STAMP) s-arm-isa

arm-cpu-data.h: s-arm-data ; @true
s-arm-data: $(srcdir)/config/arm/parsecpu.awk \
  $(srcdir)/config/arm/arm-cpus.in
	$(AWK) -f $(srcdir)/config/arm/parsecpu.awk -v cmd=data \
		$(srcdir)/config/arm/arm-cpus.in > tmp-arm-cpu-data.h
	$(SHELL) $(srcdir)/../move-if-change tmp-arm-cpu-data.h arm-cpu-data.h
	$(STAMP) s-arm-data

arm-cpu-cdata.h: s-arm-cdata ; @true
s-arm-cdata: $(srcdir)/config/arm/parsecpu.awk \
  $(srcdir)/config/arm/arm-cpus.in
	$(AWK) -f $(srcdir)/config/arm/parsecpu.awk -v cmd=common-data \
		$(srcdir)/config/arm/arm-cpus.in > tmp-arm-cpu-cdata.h
	$(SHELL) $(srcdir)/../move-if-change tmp-arm-cpu-cdata.h arm-cpu-cdata.h
	$(STAMP) s-arm-cdata

arm-native.h: s-arm-native ; @true
s-arm-native: $(srcdir)/config/arm/parsecpu.awk \
  $(srcdir)/config/arm/arm-cpus.in
	$(AWK) -f $(srcdir)/config/arm/parsecpu.awk -v cmd=native \
		$(srcdir)/config/arm/arm-cpus.in > tmp-arm-native.h
	$(SHELL) $(srcdir)/../move-if-change tmp-arm-native.h arm-native.h
	$(STAMP) s-arm-native

# The common object for this back end includes these; the rule that builds it
# does not name them, so spell out the dependency here (harmless in a
# single-target build, required when many back ends build in parallel).
arm-common.o: arm-cpu.h arm-isa.h arm-cpu-cdata.h

endif
