# nds32's sources have been converted to the 2-coefficient poly_int discipline:
# they say known_lt/maybe_ne/to_constant () rather than relying on the
# fixed-size shorthand that target code gets while NUM_POLY_INT_COEFFS is 1.
# Ask for the discipline now, so that the eventual flip to 2 coefficients is a
# no-op here.  See coretypes.h.
#
# PER OBJECT, not T_CFLAGS -- T_CFLAGS is one variable for the whole gcc/
# directory and would hand nds32's opt-in to every other back end.  See the
# same comment in config/i386/t-i386 for the full reasoning.
#
# NOTE for anyone copying this to another back end: nds32 is the first one
# whose objects have HAND-WRITTEN rules in this fragment that spell out the
# compile line themselves rather than using the generic pattern rule.  That is
# safe only because those rules pass $(ALL_COMPILERFLAGS), and
# Makefile.in:1185 puts $(CFLAGS-$@) inside ALL_CXXFLAGS.  Checked before
# building: a fragment whose rules bypassed it would compile every object
# WITHOUT the flag, report zero sites, and be indistinguishable from a back
# end that has none.
nds32_poly_objs = nds32.o nds32-cost.o nds32-fp-as-gp.o nds32-intrinsic.o \
  nds32-isr.o nds32-md-auxiliary.o nds32-memory-manipulation.o \
  nds32-pipelines-auxiliary.o nds32-predicates.o nds32-relax-opt.o \
  nds32-utils.o

$(foreach o,$(nds32_poly_objs),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))

# The machine description's conditions are nds32 target code too, and they are
# compiled inside the generated insn-* files, whose names differ between a
# single-target build (insn-recog.o) and a multi-target one
# (insn-recog-nds32.o).  Match both shapes.
nds32_poly_gen = insn-attrtab.o insn-automata.o insn-dfatab.o insn-emit.o \
  insn-extract.o insn-latencytab.o insn-modes.o insn-opinit.o insn-output.o \
  insn-peep.o insn-preds.o insn-recog.o

$(foreach o,$(nds32_poly_gen),$(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(nds32_poly_gen),$(eval CFLAGS-$(o:.o=)-nds32.o += -DTARGET_POLY_AWARE))

# insn-emit and insn-recog are split into a configured number of files.  Use
# the Makefile's own lists rather than a pattern: a pattern-specific variable
# propagates to the target's PREREQUISITES and would reach build/genemit.o and
# build/genrecog.o, generators shared by every back end.
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o) += -DTARGET_POLY_AWARE))
$(foreach o,$(INSNEMIT_SEQ_O) $(INSNRECOG_SEQ_O),\
  $(eval CFLAGS-$(o:.o=)-nds32.o += -DTARGET_POLY_AWARE))

# gencondmd is target code -- genconditions.cc writes `#define IN_TARGET_CODE
# 1' into the file it generates -- so it needs the opt-in too.  Only the
# single-target object is named here; gen-multi-target-md.awk flags each
# configured triple, reading the declaration above to decide.  See t-i386.
build/gencondmd.o : T_CFLAGS += -DTARGET_POLY_AWARE
